// ================================================================================
// FILE: RaggieSoftUpdate.rc
// PURPOSE: Windows Resource Script embedding our multi-resolution Software Update
//          icon (16x16..256x256) and File Explorer Version Details into
//          `RaggieSoftUpdate.exe`.
// ================================================================================
#include <winver.h>

101 ICON "..\\Assets\\RaggieSoftUpdate.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RaggieSoft (Michael P. Ragsdale)"
            VALUE "FileDescription", "RaggieSoft Software Update Utility (Zero-Runtime Native C++20)"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "RaggieSoftUpdate"
            VALUE "LegalCopyright", "Copyright (C) 2026 Michael P. Ragsdale (MIT License)"
            VALUE "OriginalFilename", "RaggieSoftUpdate.exe"
            VALUE "ProductName", "RaggieSoft Software Update"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
